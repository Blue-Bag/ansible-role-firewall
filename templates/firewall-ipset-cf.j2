
#################   Cloudflare Allowlisting #####################
# it is possible that CF ip ranges may change so we could create a timeout list
# for now we creat a simple list
createIPSET "{{ fw_acl_cf_ipset }}" "hash:net"

createIPSET "{{ fw_acl_cf_ipset6 }}" "hash:net" family inet6

# Now populate the set with Cloudflare IP ranges:
for x in $(curl https://www.cloudflare.com/ips-v4); do "$IPCMD" add {{ fw_acl_cf_ipset }} $x; done

for x in $(curl https://www.cloudflare.com/ips-v6); do "$IPCMD" add {{ fw_acl_cf_ipset6 }} $x; done

# Allow cloudflare traffic
iptables -A INPUT -m set --match-set {{ fw_acl_cf_ipset }} src -p tcp -m multiport --dports http,https -j ACCEPT
ip6tables -A INPUT -m set --match-set {{ fw_acl_cf_ipset6 }} src -p tcp -m multiport --dports http,https -j ACCEPT




##################  end CF Allowlisting #######################
