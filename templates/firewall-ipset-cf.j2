
#################   Cloudflare Allowlisting #####################
# The set is kept up to date by {{ firewall_script_dir }}/firewall-upd8cf.sh (cron).
# Here we only make sure it exists and seed it from the list that script
# caches, so the firewall does not depend on the network at boot.
createIPSET "{{ fw_acl_cf_ipset }}" "hash:net"

if [ -f "{{ fw_acl_cf_list }}" ]; then
  sed "s/.*/add {{ fw_acl_cf_ipset }} & -exist/" "{{ fw_acl_cf_list }}" | "$IPCMD" restore
fi

##################  end CF Allowlisting #######################
